<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.fersal.inventario.controller.ProveedoresController"
            stylesheets="@styles.css"
            prefWidth="1180.0" prefHeight="650.0">
    <top>
        <Label text="Gestión de proveedores"
               style="-fx-font-size: 20px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="18.0" right="18.0" bottom="12.0" left="18.0"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <TableView fx:id="tablaProveedores">
            <columns>
                <TableColumn fx:id="colRut" text="RUT" prefWidth="115.0"/>
                <TableColumn fx:id="colRazonSocial"
                             text="Razón social" prefWidth="190.0"/>
                <TableColumn fx:id="colGiro" text="Giro" prefWidth="140.0"/>
                <TableColumn fx:id="colTelefono"
                             text="Teléfono" prefWidth="120.0"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180.0"/>
                <TableColumn fx:id="colDireccion"
                             text="Dirección" prefWidth="190.0"/>
            </columns>
            <BorderPane.margin>
                <Insets top="4.0" right="12.0" bottom="18.0" left="18.0"/>
            </BorderPane.margin>
        </TableView>
    </center>
    <right>
        <VBox spacing="10.0" prefWidth="330.0">
            <padding>
                <Insets top="10.0" right="18.0" bottom="18.0" left="12.0"/>
            </padding>
            <Label text="Datos del proveedor"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="RUT"/>
            <TextField fx:id="txtRut" promptText="12345678-9"/>
            <Label text="Razón social"/>
            <TextField fx:id="txtRazonSocial" promptText="Empresa proveedora"/>
            <Label text="Giro"/>
            <TextField fx:id="txtGiro" promptText="Actividad comercial"/>
            <Label text="Teléfono"/>
            <TextField fx:id="txtTelefono" promptText="+56912345678"/>
            <Label text="Email"/>
            <TextField fx:id="txtEmail" promptText="contacto@empresa.cl"/>
            <Label text="Dirección"/>
            <TextField fx:id="txtDireccion" promptText="Dirección comercial"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Guardar" onAction="#guardar" maxWidth="Infinity"
                    defaultButton="true"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="Editar seleccionado" onAction="#editar"
                    maxWidth="Infinity"/>
            <Button text="Eliminar seleccionado" onAction="#eliminar"
                    maxWidth="Infinity"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
            <Button text="Limpiar" onAction="#limpiar" maxWidth="Infinity"/>
            <Button text="Cerrar" onAction="#cerrarVentana" maxWidth="Infinity"/>
        </VBox>
    </right>
</BorderPane>
